# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development

# Signs the dashboard's session cookie — anyone who has this value can forge a valid login for
# any user. The default is fine for local dev only; set a real random value (e.g. `openssl rand
# -hex 32`) before any real deployment.
SESSION_SECRET_KEY=change-me-in-production

# --- Database ---
# Host port 5433 (not 5432) — docker-compose.yml maps it there to avoid clashing with
# other Postgres containers that may already be running locally.
# Async URL used by the app at runtime (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://reply_agent:reply_agent@localhost:5433/reply_agent
# Sync URL used by Alembic migrations (psycopg driver).
DATABASE_URL_SYNC=postgresql+psycopg://reply_agent:reply_agent@localhost:5433/reply_agent
# A separate, non-superuser role used only by the web-facing dashboard/onboarding/upload routes
# (db/tenant_session.py) — row-level security has no effect on the reply_agent role above, since
# it's a Postgres superuser and owns every table. Created by
# migrations/versions/325e6d70b285_*.py; change the password before any real deployment.
DATABASE_URL_APP=postgresql+asyncpg://reply_agent_app:reply_agent_app@localhost:5433/reply_agent

# --- Queue ---
# Host port 6380 (not 6379) — same reasoning as above.
REDIS_URL=redis://localhost:6380/0

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Voyage AI (embeddings) ---
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5

# --- Meta / WhatsApp Cloud API ---
# From your Meta Developer app (System > Business Settings once verification is done).
META_APP_ID=
META_APP_SECRET=
# Your Tech Provider System User's own long-lived token (Business Settings > System Users >
# Generate New Token) — shared across every onboarded business's outbound sends, not per-number.
WHATSAPP_ACCESS_TOKEN=
# Only our own demo/dev business's number, used by scripts/seed_business.py and the eval
# harness — real onboarded businesses' numbers live in the database, not here.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Arbitrary string you choose; must match what you enter in the Meta webhook config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me
# Graph API version — verify this is still current before go-live (Meta revs it ~yearly).
META_GRAPH_API_VERSION=v21.0
# App Dashboard > Facebook Login for Business > Configurations > create one using the
# "WhatsApp Embedded Signup" template. Required for /onboarding/whatsapp to work at all.
META_EMBEDDED_SIGNUP_CONFIG_ID=

# --- Meta / Instagram Messaging + Messenger Platform ---
# Both are accessed via the connected Facebook Page's access token, not a phone-number-scoped
# one like WhatsApp — same Page token works for both channels.
META_PAGE_ACCESS_TOKEN=
# Arbitrary string you choose; shared by the Instagram + Messenger webhook subscriptions
# (separate from WHATSAPP_WEBHOOK_VERIFY_TOKEN — Meta lets you set these independently).
META_WEBHOOK_VERIFY_TOKEN=change-me
# App Dashboard > Facebook Login for Business > Configurations > a SECOND configuration (not
# the WhatsApp one above) using pages_messaging + instagram_manage_messages. Required for
# /onboarding/page to work at all.
META_PAGE_SIGNUP_CONFIG_ID=

# Owner escalation notification target (E.164, e.g. 9627xxxxxxxx) for the seller's own WhatsApp number.
OWNER_NOTIFICATION_WHATSAPP_NUMBER=

# When true, every channel's send function logs instead of calling the real Graph API — use
# for local dev before real Meta credentials exist, and for eval/run_eval.py.
META_DRY_RUN=false
